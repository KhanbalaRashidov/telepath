# Telepath configuration. Copy to .env and fill in.
# Precedence: CLI flags > environment variables > .env > built-in defaults.

# --- required ---------------------------------------------------------------

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to use the bot. Telepath refuses to
# serve any chat that is not listed here. Message @userinfobot to find your ID.
ALLOWED_CHAT_IDS=

# --- workspace --------------------------------------------------------------

# The directory the agent works in. For per-task branches this MUST be a git
# repository. Defaults to the current directory.
PROJECTS_DIR=.

# --- agents -----------------------------------------------------------------

# Default agent for a chat (claude|gemini|codex|aider). Must be in ENABLED_AGENTS.
DEFAULT_AGENT=claude

# Comma-separated enabled agents.
ENABLED_AGENTS=claude,gemini,codex,aider

# --- permissions ------------------------------------------------------------

# auto | allowlist | interactive
PERMISSION_MODE=auto

# How long to wait for an interactive approval before denying (seconds).
APPROVAL_TIMEOUT_SECONDS=120

# --- git branch workflow ----------------------------------------------------

# off | per-task
BRANCH_MODE=per-task

# Task branch name prefix.
BRANCH_PREFIX=telepath/

# Commit the agent's changes on the task branch (true|false).
BRANCH_COMMIT=true

# Stash a dirty working tree instead of refusing to start (true|false).
BRANCH_STASH_DIRTY=false

# --- agent run options ------------------------------------------------------

# Max agent turns (0 = the CLI's own default).
MAX_TURNS=0

# Model override passed to the agent ("" = the CLI's own default).
MODEL=

# --- binary overrides (optional) --------------------------------------------
# Set these only if the CLIs are not on PATH.
CLAUDE_BIN=
GEMINI_BIN=
CODEX_BIN=
AIDER_BIN=
GIT_BIN=

# --- logging ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
